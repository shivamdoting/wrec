From 6f57fbd1913b3b7e3b8d2baad53f9b077c8dfee9 Mon Sep 17 00:00:00 2001
From: Shivam Sharma <shivamhwp@users.noreply.github.com>
Date: Sat, 3 Oct 2026 14:52:48 +0000
Subject: [PATCH 1/3] screencast: copy the first frame without waiting for
 damage

copy_with_damage only completes once the output changes. A new stream,
or a stream whose PipeWire buffers were just reallocated, has no image
yet, so on an unchanged output it waits forever and the consumer never
gets a first frame. This shows up when a second recording starts on a
static screen: the first session got its frame, every later one stalls.

Use a plain copy whenever the consumer has no image, and go back to
copy_with_damage after a frame is ready, so an idle output still costs
nothing.
---
 include/screencast_common.h          | 3 +++
 src/screencast/pipewire_screencast.c | 2 ++
 src/screencast/wlr_screencast.c      | 9 ++++++++-
 3 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/include/screencast_common.h b/include/screencast_common.h
index d0a50d8..0874e51 100644
--- a/include/screencast_common.h
+++ b/include/screencast_common.h
@@ -160,6 +160,9 @@ struct xdpw_screencast_instance {
 	enum xdpw_frame_state frame_state;
 	struct wl_list buffer_list;
 	bool avoid_dmabufs;
+	// The consumer has no image yet (new stream or new buffers), so the next
+	// copy must not wait for damage.
+	bool need_full_frame;
 
 	// pipewire
 	struct pw_stream *stream;
diff --git a/src/screencast/pipewire_screencast.c b/src/screencast/pipewire_screencast.c
index 41c91ab..a193bd2 100644
--- a/src/screencast/pipewire_screencast.c
+++ b/src/screencast/pipewire_screencast.c
@@ -343,6 +343,8 @@ static void pwr_handle_stream_add_buffer(void *data, struct pw_buffer *buffer) {
 
 	logprint(DEBUG, "pipewire: add buffer event handle");
 
+	cast->need_full_frame = true;
+
 	d = buffer->buffer->datas;
 
 	// Select buffer type from negotiation result
diff --git a/src/screencast/wlr_screencast.c b/src/screencast/wlr_screencast.c
index c1fae8e..56f8d76 100644
--- a/src/screencast/wlr_screencast.c
+++ b/src/screencast/wlr_screencast.c
@@ -175,7 +175,13 @@ static void wlr_frame_buffer_done(void *data,
 	}
 
 	cast->current_frame.damage_count = 0;
-	zwlr_screencopy_frame_v1_copy_with_damage(frame, cast->current_frame.xdpw_buffer->buffer);
+	if (cast->need_full_frame) {
+		// copy_with_damage waits for the output to change, which never
+		// happens on a static screen.
+		zwlr_screencopy_frame_v1_copy(frame, cast->current_frame.xdpw_buffer->buffer);
+	} else {
+		zwlr_screencopy_frame_v1_copy_with_damage(frame, cast->current_frame.xdpw_buffer->buffer);
+	}
 	logprint(TRACE, "wlroots: frame copied");
 
 	fps_limit_measure_start(&cast->fps_limit, cast->framerate);
@@ -224,6 +230,7 @@ static void wlr_frame_ready(void *data, struct zwlr_screencopy_frame_v1 *frame,
 	logprint(TRACE, "wlroots: timestamp %"PRIu64":%"PRIu32, cast->current_frame.tv_sec, cast->current_frame.tv_nsec);
 
 	cast->frame_state = XDPW_FRAME_STATE_SUCCESS;
+	cast->need_full_frame = false;
 
 	xdpw_wlr_frame_finish(cast);
 }
