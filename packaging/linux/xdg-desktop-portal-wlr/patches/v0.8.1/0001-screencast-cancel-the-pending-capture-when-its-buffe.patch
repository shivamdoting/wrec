From fd3659e9421c730c12941114e7b3241677ae624b Mon Sep 17 00:00:00 2001
From: Shivam Sharma <shivamhwp@users.noreply.github.com>
Date: Sat, 3 Oct 2026 15:03:43 +0000
Subject: [PATCH 1/3] screencast: cancel the pending capture when its buffer is
 given back

When the stream pauses, the buffer being captured into goes back to
PipeWire, but its capture frame stays alive.

With ext-image-copy the next process callback then creates a second
frame on the same session. That is a protocol error ("session already
has a frame object") and the portal exits. It reproduces every time by
pausing a stream on a static output right after a frame, then resuming.

With wlr-screencopy the old frame keeps running without a buffer, and
its next damage event dereferences the NULL current buffer in
wlr_frame_damage(), so xdpw segfaults during pause and resume of a
moving output.

The same happens when PipeWire removes the buffer being captured into,
and when the frame limiter timer is still armed across a pause, which
can start two captures after a resume.

Cancel the pending frame and the frame limiter timer whenever the
buffer leaves our hands. Track the screencopy frame from creation so it
can be cancelled before its first event.
---
 include/ext_image_copy.h             |  1 +
 include/wlr_screencast.h             |  1 +
 include/wlr_screencopy.h             |  1 +
 src/screencast/ext_image_copy.c      |  8 ++++++++
 src/screencast/pipewire_screencast.c | 14 ++++++++++----
 src/screencast/wlr_screencast.c      | 16 ++++++++++++++++
 src/screencast/wlr_screencopy.c      |  5 +++++
 7 files changed, 42 insertions(+), 4 deletions(-)

diff --git a/include/ext_image_copy.h b/include/ext_image_copy.h
index f90cfcd..02d24ab 100644
--- a/include/ext_image_copy.h
+++ b/include/ext_image_copy.h
@@ -4,6 +4,7 @@
 #include "screencast_common.h"
 
 void xdpw_ext_ic_frame_capture(struct xdpw_screencast_instance *cast);
+void xdpw_ext_ic_frame_cancel(struct xdpw_screencast_instance *cast);
 int xdpw_ext_ic_session_init(struct xdpw_screencast_instance *cast);
 void xdpw_ext_ic_session_close(struct xdpw_screencast_instance *cast);
 
diff --git a/include/wlr_screencast.h b/include/wlr_screencast.h
index 4ec56dc..24f7ca1 100644
--- a/include/wlr_screencast.h
+++ b/include/wlr_screencast.h
@@ -25,6 +25,7 @@ bool xdpw_wlr_target_from_data(struct xdpw_screencast_context *ctx, struct xdpw_
 		struct xdpw_screencast_restore_data *data);
 
 void xdpw_wlr_frame_capture(struct xdpw_screencast_instance *cast);
+void xdpw_wlr_frame_cancel(struct xdpw_screencast_instance *cast);
 int xdpw_wlr_session_init(struct xdpw_screencast_instance *cast);
 void xdpw_wlr_session_close(struct xdpw_screencast_instance *cast);
 
diff --git a/include/wlr_screencopy.h b/include/wlr_screencopy.h
index c2bb320..08779f2 100644
--- a/include/wlr_screencopy.h
+++ b/include/wlr_screencopy.h
@@ -7,6 +7,7 @@
 #define SC_MANAGER_VERSION_MIN 2
 
 void xdpw_wlr_sc_frame_capture(struct xdpw_screencast_instance *cast);
+void xdpw_wlr_sc_frame_cancel(struct xdpw_screencast_instance *cast);
 int xdpw_wlr_sc_session_init(struct xdpw_screencast_instance *cast);
 void xdpw_wlr_sc_session_close(struct xdpw_screencast_instance *cast);
 
diff --git a/src/screencast/ext_image_copy.c b/src/screencast/ext_image_copy.c
index 8ce264c..2fd369b 100644
--- a/src/screencast/ext_image_copy.c
+++ b/src/screencast/ext_image_copy.c
@@ -306,6 +306,14 @@ void xdpw_ext_ic_frame_capture(struct xdpw_screencast_instance *cast) {
 	ext_register_frame_cb(cast);
 }
 
+void xdpw_ext_ic_frame_cancel(struct xdpw_screencast_instance *cast) {
+	if (cast->ext_session.frame) {
+		ext_image_copy_capture_frame_v1_destroy(cast->ext_session.frame);
+		cast->ext_session.frame = NULL;
+		logprint(TRACE, "ext: pending frame cancelled");
+	}
+}
+
 void xdpw_ext_ic_session_close(struct xdpw_screencast_instance *cast) {
 	if (cast->ext_session.frame) {
 		ext_image_copy_capture_frame_v1_destroy(cast->ext_session.frame);
diff --git a/src/screencast/pipewire_screencast.c b/src/screencast/pipewire_screencast.c
index 603c9e0..af7a96b 100644
--- a/src/screencast/pipewire_screencast.c
+++ b/src/screencast/pipewire_screencast.c
@@ -350,6 +350,10 @@ static void pwr_handle_stream_state_changed(void *data,
 		break;
 	case PW_STREAM_STATE_PAUSED:
 		if (old == PW_STREAM_STATE_STREAMING) {
+			// The buffer goes back to PipeWire, so nothing may still be
+			// capturing into it. A frame left pending here makes the next
+			// capture a protocol error ("session already has a frame object").
+			xdpw_wlr_frame_cancel(cast);
 			xdpw_pwr_enqueue_buffer(cast);
 		}
 		// fall through
@@ -551,15 +555,17 @@ static void pwr_handle_stream_remove_buffer(void *data, struct pw_buffer *buffer
 
 	logprint(DEBUG, "pipewire: remove buffer event handle");
 
+	if (cast->current_frame.pw_buffer == buffer) {
+		// Stop capturing into the buffer before it is destroyed.
+		xdpw_wlr_frame_cancel(cast);
+		cast->current_frame.pw_buffer = NULL;
+		cast->current_frame.xdpw_buffer = NULL;
+	}
 	struct xdpw_buffer *xdpw_buffer = buffer->user_data;
 	if (xdpw_buffer) {
 		wl_list_remove(&xdpw_buffer->link);
 		xdpw_buffer_destroy(xdpw_buffer);
 	}
-	if (cast->current_frame.pw_buffer == buffer) {
-		cast->current_frame.pw_buffer = NULL;
-		cast->current_frame.xdpw_buffer = NULL;
-	}
 	for (uint32_t plane = 0; plane < buffer->buffer->n_datas; plane++) {
 		buffer->buffer->datas[plane].fd = -1;
 	}
diff --git a/src/screencast/wlr_screencast.c b/src/screencast/wlr_screencast.c
index 0c8aad7..94c8157 100644
--- a/src/screencast/wlr_screencast.c
+++ b/src/screencast/wlr_screencast.c
@@ -49,6 +49,22 @@ void xdpw_wlr_frame_capture(struct xdpw_screencast_instance *cast) {
 	}
 }
 
+void xdpw_wlr_frame_cancel(struct xdpw_screencast_instance *cast) {
+	// A capture still waiting on the frame limiter has no frame object yet.
+	struct xdpw_timer *timer, *tmp;
+	wl_list_for_each_safe(timer, tmp, &cast->ctx->state->timers, link) {
+		if (timer->user_data == cast && timer->func == wlr_frame_capture_timer) {
+			xdpw_destroy_timer(timer);
+		}
+	}
+	if (cast->ctx->ext_image_copy_capture_manager
+			&& cast->ctx->ext_output_image_capture_source_manager) {
+		xdpw_ext_ic_frame_cancel(cast);
+	} else if (cast->ctx->screencopy_manager) {
+		xdpw_wlr_sc_frame_cancel(cast);
+	}
+}
+
 void xdpw_wlr_session_close(struct xdpw_screencast_instance *cast) {
 	if (cast->ctx->ext_image_copy_capture_manager
 			&& cast->ctx->ext_output_image_capture_source_manager) {
diff --git a/src/screencast/wlr_screencopy.c b/src/screencast/wlr_screencopy.c
index d4d0eb9..76c98bc 100644
--- a/src/screencast/wlr_screencopy.c
+++ b/src/screencast/wlr_screencopy.c
@@ -233,6 +233,7 @@ static void wlr_register_cb(struct xdpw_screencast_instance *cast) {
 	struct zwlr_screencopy_frame_v1 *frame = zwlr_screencopy_manager_v1_capture_output(
 		cast->ctx->screencopy_manager, cast->target->with_cursor, cast->target->output->output);
 	zwlr_screencopy_frame_v1_add_listener(frame, &wlr_frame_listener, cast);
+	cast->wlr_session.wlr_frame = frame;
 	logprint(TRACE, "wlroots: callbacks registered");
 }
 
@@ -245,6 +246,10 @@ void xdpw_wlr_sc_frame_capture(struct xdpw_screencast_instance *cast) {
 	wlr_register_cb(cast);
 }
 
+void xdpw_wlr_sc_frame_cancel(struct xdpw_screencast_instance *cast) {
+	wlr_frame_finish(cast);
+}
+
 void xdpw_wlr_sc_session_close(struct xdpw_screencast_instance *cast) {
 	wlr_frame_finish(cast);
 }
