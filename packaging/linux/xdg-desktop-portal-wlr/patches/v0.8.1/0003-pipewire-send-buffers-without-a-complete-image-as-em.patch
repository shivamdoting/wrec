From 775d250b4713cd934d48dfd5e846d6c67c0dee75 Mon Sep 17 00:00:00 2001
From: Shivam Sharma <shivamhwp@users.noreply.github.com>
Date: Sat, 3 Oct 2026 16:01:40 +0000
Subject: [PATCH 3/3] pipewire: send buffers without a complete image as empty

Right after the consumer renegotiates the format, it can receive one of
the new buffers before xdpw ever queued it: seq 0, pts 0, all zeroes,
and no corrupted flag, so it shows up as a black frame. It happens on
most frame rate changes (7 times in 5 sessions with stock 0.8.1) and
xdpw has no say in which buffer PipeWire hands over.

Mark every new buffer empty (chunk size 0, corrupted) until enqueue
fills it in. Do the same for a buffer queued without a complete image,
such as the one given back when the stream pauses. pipewiresrc drops
empty buffers, and other consumers already check chunk->size.
---
 src/screencast/pipewire_screencast.c | 37 +++++++++++++++++-----------
 1 file changed, 23 insertions(+), 14 deletions(-)

diff --git a/src/screencast/pipewire_screencast.c b/src/screencast/pipewire_screencast.c
index 7bbe442..e35d990 100644
--- a/src/screencast/pipewire_screencast.c
+++ b/src/screencast/pipewire_screencast.c
@@ -214,6 +214,15 @@ static void xdpw_pwr_dequeue_buffer(struct xdpw_screencast_instance *cast) {
 	cast->current_frame.completed = false;
 }
 
+static uint32_t chunk_size(struct xdpw_buffer *xdpw_buffer, uint32_t plane) {
+	// clients have implemented to check chunk->size if the buffer is valid instead
+	// of using the flags. Until they are patched we should use some arbitrary value.
+	if (xdpw_buffer->buffer_type == DMABUF && xdpw_buffer->size[plane] == 0) {
+		return 9; // This was choosen by a fair d20.
+	}
+	return xdpw_buffer->size[plane];
+}
+
 void xdpw_pwr_enqueue_buffer(struct xdpw_screencast_instance *cast) {
 	logprint(TRACE, "pipewire: enqueueing buffer");
 
@@ -285,14 +294,11 @@ void xdpw_pwr_enqueue_buffer(struct xdpw_screencast_instance *cast) {
 		}
 	}
 
-	if (buffer_corrupt) {
-		for (uint32_t plane = 0; plane < spa_buf->n_datas; plane++) {
-			d[plane].chunk->flags = SPA_CHUNK_FLAG_CORRUPTED;
-		}
-	} else {
-		for (uint32_t plane = 0; plane < spa_buf->n_datas; plane++) {
-			d[plane].chunk->flags = SPA_CHUNK_FLAG_NONE;
-		}
+	// A buffer without a complete image is sent empty, so consumers drop it
+	// instead of showing whatever it holds.
+	for (uint32_t plane = 0; plane < spa_buf->n_datas; plane++) {
+		d[plane].chunk->flags = buffer_corrupt ? SPA_CHUNK_FLAG_CORRUPTED : SPA_CHUNK_FLAG_NONE;
+		d[plane].chunk->size = buffer_corrupt ? 0 : chunk_size(xdpw_buf, plane);
 	}
 
 	for (uint32_t plane = 0; plane < spa_buf->n_datas; plane++) {
@@ -538,17 +544,20 @@ static void pwr_handle_stream_add_buffer(void *data, struct pw_buffer *buffer) {
 		d[plane].type = t;
 		d[plane].maxsize = xdpw_buffer->size[plane];
 		d[plane].mapoffset = 0;
-		d[plane].chunk->size = xdpw_buffer->size[plane];
+		// Nothing has been captured into the buffer yet. PipeWire can still
+		// hand it to the consumer, e.g. right after buffers are reallocated
+		// for a new format, so mark it empty until enqueue fills it in.
+		d[plane].chunk->size = 0;
+		d[plane].chunk->flags = SPA_CHUNK_FLAG_CORRUPTED;
 		d[plane].chunk->stride = xdpw_buffer->stride[plane];
 		d[plane].chunk->offset = xdpw_buffer->offset[plane];
 		d[plane].flags = 0;
 		d[plane].fd = xdpw_buffer->fd[plane];
 		d[plane].data = NULL;
-		// clients have implemented to check chunk->size if the buffer is valid instead
-		// of using the flags. Until they are patched we should use some arbitrary value.
-		if (xdpw_buffer->buffer_type == DMABUF && d[plane].chunk->size == 0) {
-			d[plane].chunk->size = 9; // This was choosen by a fair d20.
-		}
+	}
+	struct spa_meta_header *h;
+	if ((h = spa_buffer_find_meta_data(buffer->buffer, SPA_META_Header, sizeof(*h)))) {
+		h->flags = SPA_META_HEADER_FLAG_CORRUPTED;
 	}
 }
 
